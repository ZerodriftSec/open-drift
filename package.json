{
  "name": "zerodrift-agent",
  "version": "0.1.0",
  "description": "Open-source multi-agent smart-contract security audit platform: workflow-driven LLM audits with skills, structured finding validation, and independent review.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZerodriftSec/open-drift.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 7001",
    "mock": "node --env-file-if-exists=.env scripts/run-mock.mjs",
    "products": "next start --port 8001",
    "start": "next start --port 8001",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "openapi:generate": "openapi-gen generate",
    "openapi:check": "node scripts/check-openapi.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "ci": "pnpm openapi:check && pnpm lint && pnpm typecheck && pnpm test && pnpm format:check && pnpm build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.247",
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex": "^0.147.0",
    "@openai/codex-sdk": "^0.147.0",
    "@scalar/nextjs-api-reference": "^0.11.8",
    "@tanstack/react-query": "^5.101.2",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.17.0",
    "next": "^16.3.3",
    "next-auth": "5.0.0-beta.32",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "smol-toml": "^1.8.0",
    "solc": "^0.8.30",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.35.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^2.10.3",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "next-openapi-gen": "1.5.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.5",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.7.0"
}
